   "text": "modules:\n  payments:\n    kind: module\n    exposes:\n      - api_in\n      - ledger_out\n    members:\n      api_gw:   Gateway\n      charge:   Stage\n      ledger:   module\n      tx_store: Store\n    wires:\n      - api_gw -> charge\n      - charge -> tx_store\n      - charge -> ledger.post",
   "fontSize": 10,
   "fontFamily": 1,
