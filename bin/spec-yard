#!/usr/bin/env bash
# spec-yard: launch (or attach to) the spec-design-yard workspace in
# file-backed mode against a client repo.
#
# Usage: spec-yard [--remote] [project-dir]   (defaults to the current directory)
#
# Install once with: npm run install-cli
set -euo pipefail

# Resolve the repo root from this script's own location (follows symlinks,
# so it works when invoked via ~/.local/bin/spec-yard).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

REMOTE=0
DIR=""
for arg in "$@"; do
  case "$arg" in
    --remote)
      REMOTE=1
      ;;
    --help|-h)
      echo "Usage: spec-yard [--remote] [project-dir]"
      echo "  --remote   opt-in remote access (auth + Tailscale Serve Host allowlist)"
      exit 0
      ;;
    --*)
      echo "spec-yard: unknown option: $arg" >&2
      echo "Usage: spec-yard [--remote] [project-dir]" >&2
      exit 1
      ;;
    *)
      if [ -n "$DIR" ]; then
        echo "spec-yard: unexpected extra argument: $arg" >&2
        exit 1
      fi
      DIR="$arg"
      ;;
  esac
done
DIR="${DIR:-$PWD}"
DIR="$(cd "$DIR" 2>/dev/null && pwd)" || { echo "spec-yard: no such directory: ${1:-$PWD}" >&2; exit 1; }
URL="http://localhost:3000"

TOKEN_FILE="${SPEC_YARD_CONFIG_DIR:-$HOME/.specyard}/remote-token"

# Confirm the :3000 occupant is Spec-Yard in remote mode *before* sending
# ~/.specyard/remote-token. An unrelated process (or a local-mode instance)
# must never receive the bearer secret.
session_is_remote() {
  printf '%s' "$1" | grep -Eq '"remote"[[:space:]]*:[[:space:]]*true'
}

bearer_auth_args() {
  AUTH_ARGS=()
  if [ ! -f "$TOKEN_FILE" ]; then
    return 0
  fi
  TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
  if [ -n "$TOKEN" ]; then
    AUTH_ARGS=(-H "Authorization: Bearer $TOKEN")
  fi
}

if curl -sf -o /dev/null "$URL"; then
  # Probe without credentials. Only attach a bearer token after this
  # reports remote:true. --remote refuses a local-mode (or non-Spec-Yard)
  # occupant rather than retargeting an unauthenticated process.
  SESSION="$(curl -sS --max-time 2 "$URL/api/auth/session" || true)"
  if [ "$REMOTE" = "1" ] && ! session_is_remote "$SESSION"; then
    echo "spec-yard: a process is already listening on :3000 without remote mode." >&2
    echo "Stop it, then restart with: spec-yard --remote" >&2
    echo "Attaching --remote to a local unauthenticated server would leave it open." >&2
    exit 1
  fi
  AUTH_ARGS=()
  if session_is_remote "$SESSION"; then
    bearer_auth_args
  fi
  # A server is already up: retarget it to this project via the project API
  # (same thing the header picker does), then just open the browser.
  # JSON-encode the path properly — raw interpolation would corrupt the body
  # (or inject fields) for paths containing quotes/backslashes.
  BODY="$(python3 -c 'import json,sys; print(json.dumps({"dir": sys.argv[1]}))' "$DIR" 2>/dev/null || true)"
  if [ -n "$BODY" ] && curl -sf -o /dev/null -X PUT -H "Content-Type: application/json" \
      ${AUTH_ARGS[@]+"${AUTH_ARGS[@]}"} \
      -d "$BODY" "$URL/api/project"; then
    echo "spec-yard is already running — switched it to $DIR"
  else
    echo "spec-yard is already running — could not switch project automatically;"
    echo "use the project badge in the workspace header to select $DIR"
  fi
  open "$URL"
  exit 0
fi

cd "$REPO"
export SPEC_YARD_PROJECT_DIR="$DIR"

if [ "$REMOTE" = "1" ]; then
  export SPEC_YARD_REMOTE=1
  node "$REPO/scripts/ensure-remote-token.mjs"
  echo "[spec-yard] Remote mode: bind stays 127.0.0.1. Expose on the tailnet only:"
  echo "  tailscale serve --bg 3000"
  echo "Do NOT use tailscale funnel (public internet). Phone must be on the tailnet."
fi

npm run dev -- -H 127.0.0.1 &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null' EXIT

for _ in $(seq 1 30); do
  if curl -sf -o /dev/null "$URL"; then
    echo "spec-yard up at $URL (project dir: $DIR)"
    open "$URL"
    break
  fi
  sleep 1
done

wait "$SERVER_PID"
