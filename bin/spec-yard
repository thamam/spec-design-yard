#!/usr/bin/env bash
# spec-yard: launch (or attach to) the spec-design-yard workspace in
# file-backed mode against a client repo.
#
# Usage: spec-yard [project-dir]   (defaults to the current directory)
#
# Install once with: npm run install-cli
set -euo pipefail

# Resolve the repo root from this script's own location (follows symlinks,
# so it works when invoked via ~/.local/bin/spec-yard).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

DIR="${1:-$PWD}"
DIR="$(cd "$DIR" 2>/dev/null && pwd)" || { echo "spec-yard: no such directory: ${1:-$PWD}" >&2; exit 1; }
URL="http://localhost:3000"

if curl -sf -o /dev/null "$URL"; then
  # A server is already up: retarget it to this project via the project API
  # (same thing the header picker does), then just open the browser.
  if curl -sf -o /dev/null -X PUT -H "Content-Type: application/json" \
      -d "{\"dir\": \"$DIR\"}" "$URL/api/project"; then
    echo "spec-yard is already running — switched it to $DIR"
  else
    echo "spec-yard is already running — could not switch project automatically;"
    echo "use the project badge in the workspace header to select $DIR"
  fi
  open "$URL"
  exit 0
fi

cd "$REPO"
export SPEC_YARD_PROJECT_DIR="$DIR"

npm run dev -- -H 127.0.0.1 &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null' EXIT

for _ in $(seq 1 30); do
  if curl -sf -o /dev/null "$URL"; then
    echo "spec-yard up at $URL (project dir: $DIR)"
    open "$URL"
    break
  fi
  sleep 1
done

wait "$SERVER_PID"
